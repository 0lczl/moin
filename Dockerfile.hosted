FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY base-station/requirements-hosted.txt /app/requirements-hosted.txt
RUN pip install --no-cache-dir -r /app/requirements-hosted.txt
COPY base-station/moin_benchmark /app/moin_benchmark
COPY base-station/moin_machine /app/moin_machine
COPY base-station/moin_studio /app/moin_studio
COPY base-station/moin_haramain /app/moin_haramain
COPY base-station/tools /app/tools
COPY base-station/benchmark-data/local-comparison.json /app/benchmark-data/local-comparison.json
COPY base-station/benchmark-data/staging-renderings/renderings.quranenc.json /app/benchmark-data/staging-renderings/renderings.quranenc.json
COPY brand /brand
RUN useradd --system --uid 10001 --home /app moin \
    && mkdir -p /data/studio /data/ledger \
    && chown -R moin:moin /data
USER moin
EXPOSE 8787
CMD ["python", "-m", "moin_studio", "--public", "--host", "0.0.0.0", "--port", "8787", "--storage", "/data/studio"]
